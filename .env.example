# Salin file ini jadi ".env" lalu isi value-nya. JANGAN pernah commit ".env" (sudah di-gitignore).

# --- LLM Provider (M1 Agent Core) ---
# Sprint 1 pakai cloud API dulu untuk prototyping (provider-agnostic di kode M1),
# nanti bisa swap/tambah local inference di Sprint 8 (M12/M13).

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Provider default yang dipakai M1 kalau dua-duanya terisi: "anthropic" atau "openai"
LLM_PROVIDER=anthropic

# Model Anthropic default untuk development/testing — murah & cepat (~$0.009/test run),
# cukup untuk validasi mekanika loop. Override ke claude-sonnet-5/claude-opus-5 saat mau
# uji kualitas reasoning asli.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- M2a Short-Term Memory ---
# Ambang token (dari usage.input_tokens Anthropic) yang memicu kompaksi
# (recursive summarization) sebelum giliran berikutnya. Nilai default ini
# tebakan awal disesuaikan untuk context window claude-haiku-4-5 — aman
# di-override kalau perlu.
MEMORY_COMPACTION_THRESHOLD_TOKENS=6000

# Buffer token yang ditambahkan ke last_input_tokens sebelum dibandingkan ke
# threshold di atas. last_input_tokens itu akurat tapi "telat 1 giliran"
# (angka dari panggilan SEBELUMNYA, bukan estimasi giliran sekarang) — margin
# ini bikin kompaksi jalan sedikit lebih awal untuk mengompensasi keterlambatan
# itu, tanpa perlu menebak ukuran token giliran berikutnya.
MEMORY_COMPACTION_SAFETY_MARGIN_TOKENS=500

# Berapa banyak pesan terakhir (verbatim, tidak dipadatkan) yang tetap
# dipertahankan tiap kali kompaksi terjadi.
MEMORY_KEEP_RECENT_MESSAGES=6

# --- M2b Long-Term Memory ---
# Berapa banyak kutipan turn lama yang dikembalikan tool `recall_memory` kalau
# model tidak menyebut `limit` sendiri. Hasil recall itu kutipan verbatim dari
# arsip SQLite (backend/memory/archive/memory.db), bukan fakta — angka kecil
# sengaja dipilih supaya hasil yang kurang relevan tidak mengotori konteks.
# Hard cap 20 apa pun nilainya.
MEMORY_RECALL_DEFAULT_LIMIT=5
