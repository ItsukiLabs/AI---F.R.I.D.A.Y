# Salin file ini jadi ".env" lalu isi value-nya. JANGAN pernah commit ".env" (sudah di-gitignore).

# --- LLM Provider (M1 Agent Core) ---
# Sprint 1 pakai cloud API dulu untuk prototyping (provider-agnostic di kode M1),
# nanti bisa swap/tambah local inference di Sprint 8 (M12/M13).

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Provider default yang dipakai M1 kalau dua-duanya terisi: "anthropic" atau "openai"
LLM_PROVIDER=anthropic
